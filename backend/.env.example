# Copiá a .env y ajustá. Docker Compose expone Postgres en localhost:5433.
# Async (app FastAPI)
DATABASE_URL=postgresql+asyncpg://daily_ops:daily_ops@localhost:5433/daily_ops
# Sync (Alembic)
DATABASE_URL_SYNC=postgresql+psycopg2://daily_ops:daily_ops@localhost:5433/daily_ops

CORS_ORIGINS=http://localhost:3000
DEFAULT_PROPERTY=COWLCR

# El app no tiene autenticacion: no hay login, ni password compartido, ni
# usuarios/roles. Todos los endpoints son publicos para quien alcance la URL.
